{
  "compilerOptions": {
    "composite": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "node_modules/.tsbuild/node"
  },
  "include": ["src/.vitepress/config/**/*.ts", "src/.vitepress/config.ts"]
}
